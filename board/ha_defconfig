# c4-ea-homeassistant — the Home Assistant layer.
#
# openHC's build.sh appends this LAST (OHC_EXTRA_DEFCONFIG) to whichever EA
# board is being built, so it wins every assignment. Board differences stay in
# openHC; only what HA needs on top of an openHC EA image goes here.

# EA userspace is x86_64 glibc, so HA's manylinux wheels install with pip.
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_ZSTD=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON3_DECIMAL=y
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON_PIP=y
